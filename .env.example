# Copy to .env.local and fill in real values (.env.local is gitignored).
# DATABASE_URL matches the Postgres service in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/partner_coach_bot?schema=public"
# AI provider: "ollama" (default, local) or "anthropic" (cloud, opt-in)
AI_PROVIDER="ollama"
# Ollama API base URL (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434"
# Ollama model name
OLLAMA_MODEL="gemma4:26#
# Anthropic API key (set AI_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=""
# Anthropic model override
# ANTHROPIC_MODEL="claude-sonnet-4-5"
