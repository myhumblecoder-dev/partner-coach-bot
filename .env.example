# Copy to .env.local and fill in real values (.env.local is gitignored).
# DATABASE_URL matches the Postgres service in docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/partner_coach_bot?schema=public"
# AI provider: "ollama" (default, local) or "anthropic" (cloud, opt-in)
AI_PROVIDER="ollama"
# Ollama API base URL (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434"
# Ollama model name
OLLAMA_MODEL="gemma4:26"
# Anthropic API key (set AI_PROVIDER=webhook to use)
# ANTHROPIC_API_KEY=""
# Anthropic model override
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# NextAuth
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
# Magic-link email transport (SMTP URL format)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="noreply@example.com"
# Telegram Bot Token (obtained from @BotFather)
# TELEGRAM_BOT_TOKEN=""
# Telegram Webhook Secret (a value you choose and pass to setWebhook)
# TELEGRAM_WEBHOOK_SECRET=""
# Cron Secret (a value you set in Vercel for the cron job)
# CRON_SECRET=""
